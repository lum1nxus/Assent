{
  "name": "atof",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Reads the Terms of Service so you don't have to. Shows a risk score before you click 'I Agree'.",
  "homepage": "https://github.com/lum1nxus/atof",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lum1nxus/atof.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint extension tests scripts",
    "format": "prettier --write \"**/*.{js,json,html,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,json,html,md}\" --ignore-path .prettierignore",
    "test": "node --test tests/*.test.js",
    "eval": "node scripts/eval-pipeline.mjs",
    "eval:verbose": "node scripts/eval-pipeline.mjs --verbose",
    "replay": "node scripts/replay-debug.mjs",
    "zip": "rm -f atof-*.zip && cd extension && zip -r ../atof-${npm_package_version}.zip . -x '*.DS_Store' '*/.DS_Store'"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0"
  }
}
